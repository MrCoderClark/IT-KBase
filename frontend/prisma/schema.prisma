// Prisma schema for TechBase — IT Knowledge Base
// Source of truth: Docs/specs/03-data-model.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "auth"]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  reader
  author
  reviewer
  admin

  @@schema("public")
}

enum ArticleStatus {
  draft
  in_review
  published
  archived

  @@schema("public")
}

enum ArticleVisibility {
  private
  public

  @@schema("public")
}

enum ArticleAccessMode {
  inherit
  library
  role_floor

  @@schema("public")
}

enum SectionKind {
  overview
  prerequisites
  steps
  verification
  troubleshooting
  related
  custom

  @@schema("public")
}

enum BlockKind {
  prose
  step
  callout
  code
  image
  checklist

  @@schema("public")
}

enum CalloutVariant {
  info
  important
  warning
  success

  @@schema("public")
}

enum SourceKind {
  docx
  pdf
  manual
  url

  @@schema("public")
}

enum JobStatus {
  queued
  parsing
  extracting
  structuring
  validating
  succeeded
  failed
  cancelled

  @@schema("public")
}

enum NotificationKind {
  ingestion_complete
  review_requested
  mention

  @@schema("public")
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role       Role     @default(author)
  avatarUrl  String?
  identityId String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  articles      Article[]        @relation("ArticleAuthor")
  versions      ArticleVersion[] @relation("VersionAuthor")
  feedback      Feedback[]
  notes         ArticleNote[]    @relation("NoteAuthor")
  notifications Notification[]

  @@schema("public")
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  color    String?
  articles Article[]

  @@schema("public")
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique
  articles ArticleTag[]

  @@schema("public")
}

model Article {
  id                 String        @id @default(cuid())
  slug               String        @unique
  title              String
  summary            String?
  heroImageUrl       String?
  status             ArticleStatus     @default(draft)
  visibility         ArticleVisibility @default(private)
  readingTimeMinutes Int               @default(0)
  version            String        @default("1.0")

  // Per-page access (spec 12-per-page-permissions.md)
  accessMode      ArticleAccessMode @default(inherit)
  accessRoleFloor Role? // set when accessMode = role_floor

  // Page tree (spec 10-page-tree.md)
  parentId String?
  parent   Article?  @relation("ArticleTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Article[] @relation("ArticleTree")
  order    Int       @default(0)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  authorId String
  author   User   @relation("ArticleAuthor", fields: [authorId], references: [id])

  currentVersionId String?         @unique
  currentVersion   ArticleVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])

  draftVersionId String?         @unique
  draftVersion   ArticleVersion? @relation("DraftVersion", fields: [draftVersionId], references: [id])

  versions ArticleVersion[] @relation("ArticleVersions")

  tags         ArticleTag[]
  feedback     Feedback[]
  notes        ArticleNote[]
  articleViews ArticleView[]
  ingestionJob IngestionJob?

  views      Int @default(0)
  helpful    Int @default(0)
  notHelpful Int @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  searchVector Unsupported("tsvector")?

  @@index([status, updatedAt])
  @@index([categoryId])
  @@index([parentId, order])
  @@schema("public")
}

model ArticleVersion {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation("ArticleVersions", fields: [articleId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("VersionAuthor", fields: [authorId], references: [id])

  version  String
  title    String
  summary  String?
  sections Section[]
  notes    String?

  createdAt DateTime @default(now())

  currentFor Article? @relation("CurrentVersion")
  draftFor   Article? @relation("DraftVersion")

  @@unique([articleId, version])
  @@index([articleId, createdAt])
  @@schema("public")
}

model Section {
  id        String         @id @default(cuid())
  versionId String
  version   ArticleVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  kind      SectionKind
  title     String
  order     Int
  blocks    Block[]

  @@index([versionId, order])
  @@schema("public")
}

model Block {
  id        String  @id @default(cuid())
  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  kind      BlockKind
  order     Int

  content Json?

  stepNumber     Int?
  calloutVariant CalloutVariant?
  language       String?
  code           String?
  imageUrl       String?
  imageAlt       String?

  @@index([sectionId, order])
  @@schema("public")
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
  @@schema("public")
}

model Feedback {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  helpful   Boolean
  comment   String?
  createdAt DateTime @default(now())

  @@index([articleId, createdAt])
  @@schema("public")
}

/// A note left after someone ran the procedure. Not a helpful/not-helpful vote.
model ArticleNote {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("NoteAuthor", fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([articleId, createdAt])
  @@schema("public")
}

/// One row per viewer per UTC day. A repeat open that day does not add another view.
model ArticleView {
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  viewerKey String
  day       String
  createdAt DateTime @default(now())

  @@id([articleId, viewerKey, day])
  @@index([day])
  @@schema("public")
}

model IngestionJob {
  id             String     @id @default(cuid())
  articleId      String?    @unique
  article        Article?   @relation(fields: [articleId], references: [id])
  sourceKind     SourceKind
  sourceFileKey  String
  sourceFileName String
  sizeBytes      Int
  status         JobStatus  @default(queued)
  errorMessage   String?
  /// Per-stage timings for one import: { stages: [{ stage, durationMs, detail }], totalMs }
  trace          Json?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdById    String
  createdAt      DateTime   @default(now())

  @@index([status, createdAt])
  @@schema("public")
}

/// In-app bell items for the signed-in user (F2).
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  title     String
  body      String?
  href      String?
  articleId String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@schema("public")
}

/// Single row (`id` = "default") for admin-owned site options.
model SiteSetting {
  id                   String   @id @default("default")
  accentHex            String   @default("#1E6BFF")
  logoUrl              String?
  versionRetentionDays Int      @default(365)
  allowedEmailDomains  String[] @default([])
  updatedAt            DateTime @updatedAt

  @@map("site_setting")
  @@schema("public")
}

/// Admin integrations shell (ServiceNow, Jira, Teams, Slack). Live calls come later.
model IntegrationSetting {
  kind       String    @id
  enabled    Boolean   @default(false)
  config     Json      @default("{}")
  lastTestAt DateTime?
  lastTestOk Boolean?
  lastSyncAt DateTime?
  updatedAt  DateTime  @updatedAt

  @@map("integration_setting")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Auth schema — owned by the auth module. No relation to User.
// See Docs/specs/adr/0001-server-managed-sessions.md
// ---------------------------------------------------------------------------

model Identity {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  emailVerified DateTime?
  disabledAt    DateTime?
  sessionGen    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions IdentitySession[]
  tokens   EmailToken[]
  totp     TotpCredential?
  recovery RecoveryCode[]
  challenges MfaChallenge[]
  passkeys   Passkey[]
  passkeyChallenges PasskeyChallenge[]

  @@map("identity")
  @@schema("auth")
}

model IdentitySession {
  id         String    @id @default(cuid())
  identityId String
  identity   Identity  @relation(fields: [identityId], references: [id], onDelete: Cascade)
  secretHash String    @unique
  expiresAt  DateTime
  idleAt     DateTime
  revokedAt  DateTime?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([identityId])
  @@map("session")
  @@schema("auth")
}

model EmailToken {
  id         String    @id @default(cuid())
  identityId String
  identity   Identity  @relation(fields: [identityId], references: [id], onDelete: Cascade)
  purpose    String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([identityId])
  @@map("email_token")
  @@schema("auth")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  attempted DateTime @default(now())

  @@index([key, attempted])
  @@map("login_attempt")
  @@schema("auth")
}

model TotpCredential {
  id           String    @id @default(cuid())
  identityId   String    @unique
  identity     Identity  @relation(fields: [identityId], references: [id], onDelete: Cascade)
  secretCipher String
  confirmedAt  DateTime?
  lastStep     Int?
  createdAt    DateTime  @default(now())

  @@map("totp")
  @@schema("auth")
}

model RecoveryCode {
  id         String    @id @default(cuid())
  identityId String
  identity   Identity  @relation(fields: [identityId], references: [id], onDelete: Cascade)
  codeHash   String    @unique
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([identityId])
  @@map("recovery_code")
  @@schema("auth")
}

model MfaChallenge {
  id         String   @id @default(cuid())
  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  secretHash String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identityId])
  @@map("mfa_challenge")
  @@schema("auth")
}

model Passkey {
  id           String   @id @default(cuid())
  identityId   String
  identity     Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    Bytes
  counter      Int      @default(0)
  transports   String   @default("")
  name         String
  createdAt    DateTime @default(now())

  @@index([identityId])
  @@map("passkey")
  @@schema("auth")
}

model PasskeyChallenge {
  id         String    @id @default(cuid())
  identityId String?
  identity   Identity? @relation(fields: [identityId], references: [id], onDelete: Cascade)
  secretHash String    @unique
  purpose    String
  challenge  String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([identityId])
  @@map("passkey_challenge")
  @@schema("auth")
}

model AuthAuditEvent {
  id         String   @id @default(cuid())
  identityId String?
  action     String
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([identityId, createdAt])
  @@map("audit_event")
  @@schema("auth")
}
