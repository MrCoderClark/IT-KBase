# Copy to frontend/.env and fill in. Never commit real secrets.
# Prisma
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/techbase

# Auth (ADR 0001 / 0002)
AUTH_COOKIE_NAME=__Host-tb_session
AUTH_ASSERTION_KEYS=local:replace-me-shared-with-backend
AUTH_MFA_KEY=replace-me-base64-32-bytes
AUTH_WEBAUTHN_RP_ID=localhost
AUTH_WEBAUTHN_ORIGIN=http://localhost:3000

# Ingestion BFF → FastAPI
INGESTION_URL=http://127.0.0.1:8080

# Redis (BullMQ ingest queue + job SSE streams). When unset, import runs in-process on the stream route.
REDIS_URL=redis://127.0.0.1:6379
# INGEST_WORKER_CONCURRENCY=2

# OpenTelemetry (optional). Local Tempo: infra/otel/ — http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Email (password reset / verification)
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com

# Vercel cron / local purge job
CRON_SECRET=replace-me-long-random
