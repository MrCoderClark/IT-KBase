# Copy to backend/.env and fill in. Never commit real secrets.
TB_ENV=local
TB_LOG_LEVEL=INFO
TB_HOST=127.0.0.1
TB_PORT=8080

# Must match AUTH_ASSERTION_KEYS in frontend/.env (kid:secret)
TB_ASSERTION_KEYS=local:replace-me-shared-with-frontend
# Optional background job tokens (comma-separated sv_...)
TB_SERVICE_TOKENS=

# S3-compatible uploads (SeaweedFS / MinIO)
TB_S3_ENDPOINT=http://127.0.0.1:8333
TB_S3_REGION=us-east-1
TB_S3_BUCKET=uploads
TB_S3_ACCESS_KEY=
TB_S3_SECRET_KEY=

# LLM (leave AI_API_KEY empty to skip structuring)
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=
